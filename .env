# ── Bot ──
BOT_TOKEN=123456:ABC-your-bot-token
GAME_URL=https://your-deployed-game.com
PORT=8000

# ── Mini App button (jo /game pe dikhega) ──
# Ye wahi t.me direct link hai jo game open karta hai,
# apne bot ke username/short_name ke hisaab se badlo:
MINI_APP_URL=https://t.me/Penfightgamebot/penfight

# ── Userbot (MTProto) ──
# my.telegram.org → API Development Tools se milta hai
API_ID=1234567
API_HASH=abcdef0123456789abcdef0123456789

# ── Auth ──
OWNER_ID=123456789
AUTH_USER_IDS=123456789,987654321,555666777

# ── Security thresholds ──
ABUSE_THRESHOLD=5
ABUSE_WINDOW_SECONDS=60
