# The ONLY required environment variable for the Pen Fight bot.
# From @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: logging level (default INFO)
# LOG_LEVEL=INFO

# Render injects PORT automatically (default 10000); no need to set it.
# PORT=10000
