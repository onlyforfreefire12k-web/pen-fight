# ---------------------------------------------------------------------------
# Pen Fight Bot — environment variables
# Copy this file to ".env" and fill in your real values:
#     cp .env.example .env
# NEVER commit the real .env file to git (add it to .gitignore).
# ---------------------------------------------------------------------------

# 1) Token from @BotFather on Telegram  (keep this SECRET!)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) HTTPS URL of your already-deployed Pen Fight Web App (the game frontend)
GAME_URL=https://your-pen-fight-game.onrender.com

# 3) Port for the health server (Render sets PORT automatically for you)
PORT=8000
